---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { firstHeadingAsTitle, firstParagraphAsSummary, prettyIdToTitle } from '../../lib/meta';

const [required, optional, startup] = await Promise.all([
  getCollection('prompts-required'),
  getCollection('prompts-optional'),
  getCollection('prompts-startup'),
]);

const byId = <T extends { id: string }>(list: T[]) =>
  list.slice().sort((a, b) => a.id.localeCompare(b.id));

const sections = [
  {
    label: '필수',
    description: '매 세션·매 커밋·매 배포에 빠짐없이 돌리는 루틴.',
    entries: byId(required),
    base: '/prompts/required',
  },
  {
    label: '선택',
    description: '필요한 상황에서만 꺼내 쓰는 심화 점검용 프롬프트.',
    entries: byId(optional),
    base: '/prompts/optional',
  },
  {
    label: '시작 (상황별)',
    description: '숙련도 × 환경(집/회사/모바일/공용) × 맥락(신규/기존) 로 골라 쓰는 세션 시작 프롬프트.',
    entries: byId(startup),
    base: '/prompts/startup',
  },
];
---

<Base title="프롬프트 · meticulous-monet" pageTitle="프롬프트">
  <article class="prose">
    <h1>프롬프트</h1>
    <p>
      Claude Code 세션에 그대로 붙여넣어 쓰는 프롬프트. 필수 / 선택 / 상황별 시작
      세 범주로 나뉩니다. 일반 AI 프롬프트를 모아두는 곳은
      <a href="/library/">라이브러리</a> 에 따로 있어요.
    </p>

    {sections.map((section) => (
      <>
        <h2>{section.label}</h2>
        <p>{section.description}</p>
        <ul class="doc-list">
          {section.entries.map((entry) => (
            <li>
              <a href={`${section.base}/${entry.id}/`} class="doc-link">
                <span class="doc-title">
                  {firstHeadingAsTitle(entry.body, prettyIdToTitle(entry.id))}
                </span>
                {firstParagraphAsSummary(entry.body) && (
                  <span class="doc-summary">{firstParagraphAsSummary(entry.body)}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </>
    ))}
  </article>
</Base>

<style>
  .doc-list {
    list-style: none;
    padding: 0;
    margin: 1em 0 1.6em;
  }
  .doc-list li {
    margin: 0;
    border-bottom: 1px solid var(--color-line);
  }
  .doc-list li:first-child { border-top: 1px solid var(--color-line); }
  .doc-link {
    display: block;
    padding: 0.75rem 0.25rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  .doc-link:hover {
    background: color-mix(in oklab, var(--color-ink) 4%, transparent);
  }
  .doc-link:hover .doc-title { color: var(--color-accent); }
  .doc-title {
    display: block;
    font-weight: 600;
    font-size: 14.5px;
    line-height: 1.4;
  }
  .doc-summary {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.5;
  }
</style>
