---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { firstHeadingAsTitle, prettyIdToTitle } from '../lib/meta';

const [checklists, library] = await Promise.all([
  getCollection('checklists'),
  getCollection('library'),
]);

function findChecklist(id: string) {
  return checklists.find((e) => e.id.toLowerCase() === id);
}
const onboarding = findChecklist('onboarding');
const security = findChecklist('security_checklist');
const newProject = findChecklist('new_project_checklist');

const recentLibrary = library
  .slice()
  .sort((a, b) => {
    const ta = a.data.added ? a.data.added.getTime() : -Infinity;
    const tb = b.data.added ? b.data.added.getTime() : -Infinity;
    return tb - ta || a.data.title.localeCompare(b.data.title);
  })
  .slice(0, 5);

function title(e: { body?: string; id: string }) {
  return firstHeadingAsTitle(e?.body ?? '', prettyIdToTitle(e?.id ?? ''));
}
---

<Base title="meticulous-monet — Claude Code 안전 사용 웹진">
  <article class="prose">
    <h1>meticulous-monet</h1>
    <p>
      Claude Code 를 <strong>여러 환경(집·회사·모바일)</strong> 과
      <strong>여러 계정(개인·회사·공용)</strong> 에서 쓰는 사람들이 흔히 놓치는 원칙을
      체크리스트와 프롬프트로 모아둔 웹진입니다.
    </p>
    <p>왼쪽 메뉴에서 원하는 문서를 골라 읽으시면 됩니다. 처음이라면 아래 순서대로.</p>

    <h2>처음 오셨다면</h2>
    <ol>
      {onboarding && (
        <li>
          <a href={`/checklists/${onboarding.id}/`}>{title(onboarding)}</a> — 15분.
        </li>
      )}
      {security && (
        <li>
          <a href={`/checklists/${security.id}/`}>{title(security)}</a> — 매 세션 확인 항목 마스터.
        </li>
      )}
      {newProject && (
        <li>
          <a href={`/checklists/${newProject.id}/`}>{title(newProject)}</a> — 새 레포 만들기 전.
        </li>
      )}
    </ol>

    <h2>매일 쓰는 흐름</h2>
    <ol>
      <li>
        세션 시작 — <code>/startup</code> 또는 <code>/security-check</code>
      </li>
      <li>커밋 직전 — <code>/pre-commit-check</code></li>
      <li>배포 직전 — <code>/pre-deploy-check</code></li>
      <li>새 이슈 발견 — <code>/update-checklist &lt;요약&gt;</code></li>
      <li>
        좋은 AI 프롬프트 발견 — <code>/add-prompt</code> → <a href="/library/">라이브러리</a> 에 저장
      </li>
    </ol>

    {recentLibrary.length > 0 && (
      <>
        <h2>최근 모은 프롬프트</h2>
        <ul>
          {recentLibrary.map((e) => (
            <li>
              <a href={`/library/${e.id}/`}>{e.data.title}</a>
              {e.data.tags.length > 0 && (
                <span class="tag-row">
                  {e.data.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </span>
              )}
            </li>
          ))}
        </ul>
      </>
    )}
  </article>
</Base>

<style>
  .tag-row {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-left: 0.5rem;
    vertical-align: middle;
  }
  .tag {
    display: inline-block;
    font-size: 11px;
    padding: 0.1rem 0.45rem;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--color-ink) 7%, transparent);
    color: var(--color-muted);
  }
</style>
