---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { rawFile, fmtDate, blurb } from '../../lib/library';

const raw = await getCollection('library');

const entries = raw
  .map((e) => ({
    id: e.id,
    data: e.data,
    body: e.body ?? '',
  }))
  .sort((a, b) => {
    const ta = a.data.added ? a.data.added.getTime() : -Infinity;
    const tb = b.data.added ? b.data.added.getTime() : -Infinity;
    if (ta !== tb) return tb - ta;
    return a.data.title.localeCompare(b.data.title);
  });

// Tag counts, most-used first.
const tagCount = new Map<string, number>();
for (const e of entries) for (const t of e.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

// Combined export blob (all entries, original files verbatim, joined).
const today = new Date().toISOString().slice(0, 10);
const SEP = '\n\n<!-- ─────────────────────────────────────────── -->\n\n';
const combined =
  `# AI 프롬프트 라이브러리 — 전체 내보내기 (${entries.length}개 · ${today})\n` +
  `\n> meticulous-monet / library/ 에서 내보냄. 각 항목은 원본 .md 파일 그대로입니다.\n` +
  SEP +
  entries.map((e) => rawFile(e.id).trimEnd()).join(SEP) +
  '\n';
const exportName = `prompt-library-${today}.md`;
---

<Base title="라이브러리 · meticulous-monet" pageTitle="라이브러리">
  <header class="pb-6">
    <p class="text-[12px] uppercase tracking-[0.18em] text-[var(--color-muted)]">Library</p>
    <h1 class="mt-2 text-[26px] sm:text-[30px] leading-tight tracking-tight font-semibold">
      AI 프롬프트 라이브러리
    </h1>
    <p class="mt-3 text-[15px] text-[var(--color-muted)] leading-relaxed max-w-[62ch]">
      쓸 만한 AI 프롬프트를 발견할 때마다 모아둔 곳. 태그로 거르고, 클릭하면 전문을 보고
      그대로 복사하거나 <code class="font-mono text-[13.5px]">.md</code> 로 내보낼 수 있습니다.
      추가는 <code class="font-mono text-[13.5px]">/add-prompt</code> 또는
      <code class="font-mono text-[13.5px]">library/</code> 에 직접.
    </p>
  </header>

  <div class="flex flex-wrap items-center gap-2 mb-5">
    <button
      type="button"
      data-tag="*"
      class="tag-chip is-active text-[12.5px] rounded-full border border-[var(--color-line)] px-2.5 py-1"
    >
      전체 <span class="opacity-60">{entries.length}</span>
    </button>
    {
      tags.map(([t, n]) => (
        <button
          type="button"
          data-tag={t}
          class="tag-chip text-[12.5px] rounded-full border border-[var(--color-line)] px-2.5 py-1"
        >
          {t} <span class="opacity-60">{n}</span>
        </button>
      ))
    }
  </div>

  <div class="flex items-center justify-between gap-3 mb-3 text-[12.5px] text-[var(--color-muted)]">
    <span data-result-count>{entries.length}개</span>
    <button
      type="button"
      id="export-all"
      class="rounded-md border border-[var(--color-line)] px-2.5 py-1 hover:border-[var(--color-ink)] transition-colors"
    >
      전체 .md 다운로드
    </button>
  </div>

  <div class="grid gap-3" id="lib-list">
    {
      entries.map((e) => (
        <a
          href={`/library/${e.id}/`}
          class="lib-card group block border border-[var(--color-line)] rounded-lg px-4 py-4 sm:px-5 sm:py-5 hover:border-[var(--color-ink)] transition-colors"
          data-tags={e.data.tags.join('|')}
        >
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[12px] text-[var(--color-muted)] mb-1.5">
            {e.data.tags.map((t) => (
              <span class="rounded-full bg-[color-mix(in_oklab,var(--color-ink)_7%,transparent)] px-2 py-0.5">
                {t}
              </span>
            ))}
            {fmtDate(e.data.added) && <span class="ml-auto">{fmtDate(e.data.added)}</span>}
          </div>
          <h3 class="text-[15px] sm:text-base font-semibold leading-snug tracking-tight group-hover:text-[var(--color-accent)] transition-colors">
            {e.data.title}
          </h3>
          {blurb({ summary: e.data.summary, note: e.data.note, body: e.body }) && (
            <p class="mt-1.5 text-[13.5px] text-[var(--color-muted)] leading-relaxed line-clamp-3">
              {blurb({ summary: e.data.summary, note: e.data.note, body: e.body })}
            </p>
          )}
        </a>
      ))
    }
  </div>

  {
    entries.length === 0 && (
      <p class="text-[14px] text-[var(--color-muted)] mt-4">
        아직 항목이 없습니다. <code class="font-mono text-[13px]">/add-prompt</code> 로 첫 프롬프트를 추가하세요.
      </p>
    )
  }

  <p data-empty-msg hidden class="text-[14px] text-[var(--color-muted)] mt-4">
    이 태그에 해당하는 프롬프트가 없습니다.
  </p>
</Base>

<style>
  .tag-chip { cursor: pointer; transition: border-color 0.15s, background-color 0.15s, color 0.15s; }
  .tag-chip:hover { border-color: var(--color-ink); }
  .tag-chip.is-active {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }
  .lib-card[hidden] { display: none; }
</style>

<script define:vars={{ combined, exportName }}>
  // ── 태그 필터 (여러 개 선택 시 합집합) ────────────────────────────
  const chips = [...document.querySelectorAll('.tag-chip')];
  const allChip = document.querySelector('.tag-chip[data-tag="*"]');
  const cards = [...document.querySelectorAll('.lib-card')];
  const countEl = document.querySelector('[data-result-count]');
  const emptyEl = document.querySelector('[data-empty-msg]');
  const active = new Set();

  function apply() {
    if (allChip) allChip.classList.toggle('is-active', active.size === 0);
    for (const c of chips) {
      if (c === allChip) continue;
      c.classList.toggle('is-active', active.has(c.dataset.tag));
    }
    let shown = 0;
    for (const card of cards) {
      const tags = (card.dataset.tags || '').split('|').filter(Boolean);
      const ok = active.size === 0 || tags.some((t) => active.has(t));
      card.hidden = !ok;
      if (ok) shown++;
    }
    if (countEl) countEl.textContent = shown + '개';
    if (emptyEl) emptyEl.hidden = shown !== 0;
  }

  for (const c of chips) {
    c.addEventListener('click', () => {
      const tag = c.dataset.tag;
      if (tag === '*') active.clear();
      else if (active.has(tag)) active.delete(tag);
      else active.add(tag);
      apply();
    });
  }

  // Honor ?tag=... from a deep link (e.g. from an entry page).
  const wanted = new URLSearchParams(location.search).get('tag');
  if (wanted && chips.some((c) => c.dataset.tag === wanted)) {
    active.add(wanted);
    apply();
  }

  // ── 전체 .md 다운로드 ────────────────────────────────────────────
  const exportBtn = document.getElementById('export-all');
  if (exportBtn) {
    exportBtn.addEventListener('click', () => {
      const blob = new Blob([combined], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = exportName;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });
  }
</script>
