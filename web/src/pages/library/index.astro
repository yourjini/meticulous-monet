---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { rawFile, fmtDate, blurb } from '../../lib/library';

const raw = await getCollection('library');

const entries = raw
  .map((e) => ({
    id: e.id,
    data: e.data,
    body: e.body ?? '',
  }))
  .sort((a, b) => {
    const ta = a.data.added ? a.data.added.getTime() : -Infinity;
    const tb = b.data.added ? b.data.added.getTime() : -Infinity;
    if (ta !== tb) return tb - ta;
    return a.data.title.localeCompare(b.data.title);
  });

const tagCount = new Map<string, number>();
for (const e of entries) for (const t of e.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const today = new Date().toISOString().slice(0, 10);

// "+ 새 프롬프트" — GitHub web editor 를 새 파일 만들기 모드로 연다.
// 프론트매터 템플릿이 미리 채워진 채로 열리고, 사용자가 작성·커밋하면
// Vercel git 연동이 자동 배포한다. (정적 사이트라 폼 백엔드가 없어도 추가가 됨)
const REPO = 'yourjini/meticulous-monet';
const BRANCH = 'claude/security-checklist-setup-HSGtg';
const tmpl =
  '---\n' +
  'title: \n' +
  'tags: [개발]\n' +
  'source: \n' +
  `added: ${today}\n` +
  'model: any\n' +
  '---\n\n';
const newPromptUrl =
  `https://github.com/${REPO}/new/${BRANCH}` +
  `?filename=library%2Funtitled.md&value=${encodeURIComponent(tmpl)}`;

const SEP = '\n\n<!-- ─────────────────────────────────────────── -->\n\n';
const combined =
  `# AI 프롬프트 라이브러리 — 전체 내보내기 (${entries.length}개 · ${today})\n` +
  `\n> meticulous-monet / library/ 에서 내보냄. 각 항목은 원본 .md 파일 그대로입니다.\n` +
  SEP +
  entries.map((e) => rawFile(e.id).trimEnd()).join(SEP) +
  '\n';
const exportName = `prompt-library-${today}.md`;
---

<Base title="라이브러리 · meticulous-monet" pageTitle="라이브러리">
  <article>
    <h1 class="title">라이브러리</h1>
    <p class="lead">
      쓸 만한 AI 프롬프트를 발견할 때마다 모아둔 곳. 왼쪽 트리에서 바로 클릭해도 되고,
      아래 태그로 좁힌 뒤 골라도 됩니다. 클릭하면 전문을 보고 그대로 복사하거나
      <code>.md</code> 로 내보낼 수 있어요. <strong>추가</strong>는 오른쪽
      <em>+ 새 프롬프트</em> 버튼(GitHub web editor 로 열림) 또는 Claude Code 에서
      <code>/add-prompt</code>.
    </p>

    <div class="filter-bar">
      <div class="tag-chips" role="toolbar" aria-label="태그 필터">
        <button type="button" data-tag="*" class="tag-chip is-active">
          전체 <span class="cnt">{entries.length}</span>
        </button>
        {tags.map(([t, n]) => (
          <button type="button" data-tag={t} class="tag-chip">
            {t} <span class="cnt">{n}</span>
          </button>
        ))}
      </div>
      <div class="action-group">
        <a
          href={newPromptUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="add-btn"
          title="GitHub web editor 로 새 파일 만들기"
        >
          + 새 프롬프트
        </a>
        <button type="button" id="export-all" class="export-btn">
          전체 .md 다운로드
        </button>
      </div>
    </div>

    <p class="result-line">
      <span data-result-count>{entries.length}</span>개 항목
    </p>

    <ul class="lib-list" id="lib-list">
      {entries.map((e) => (
        <li class="lib-row" data-tags={e.data.tags.join('|')}>
          <a href={`/library/${e.id}/`} class="lib-link">
            <div class="lib-head">
              <span class="lib-title">{e.data.title}</span>
              {fmtDate(e.data.added) && <span class="lib-date">{fmtDate(e.data.added)}</span>}
            </div>
            <div class="lib-meta">
              {e.data.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
              {e.data.model && e.data.model !== 'any' && (
                <span class="model">· {e.data.model}</span>
              )}
            </div>
            {blurb({ summary: e.data.summary, note: e.data.note, body: e.body }) && (
              <p class="lib-summary">
                {blurb({ summary: e.data.summary, note: e.data.note, body: e.body })}
              </p>
            )}
          </a>
        </li>
      ))}
    </ul>

    {entries.length === 0 && (
      <p class="empty">
        아직 항목이 없습니다. <code>/add-prompt</code> 로 첫 프롬프트를 추가하세요.
      </p>
    )}
    <p data-empty-msg hidden class="empty">
      이 태그에 해당하는 프롬프트가 없습니다.
    </p>
  </article>
</Base>

<style>
  .title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 2.6vw + 1rem, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.022em;
    line-height: 1.2;
    margin: 0;
  }
  .lead {
    margin: 0.9rem 0 1.6rem;
    color: var(--color-ink);
    font-size: 14.5px;
    line-height: 1.7;
    max-width: 62ch;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .tag-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    flex: 1 1 auto;
  }
  .tag-chip {
    appearance: none;
    cursor: pointer;
    font-size: 12.5px;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink);
    padding: 0.2rem 0.65rem;
    line-height: 1.4;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }
  .tag-chip:hover { border-color: var(--color-ink); }
  .tag-chip.is-active {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }
  .tag-chip .cnt { opacity: 0.6; margin-left: 0.15rem; }

  .action-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .add-btn,
  .export-btn {
    appearance: none;
    cursor: pointer;
    font-size: 12.5px;
    border-radius: 6px;
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink);
    padding: 0.3rem 0.7rem;
    text-decoration: none;
    line-height: 1.4;
  }
  .add-btn { font-weight: 600; }
  .add-btn:hover,
  .export-btn:hover { border-color: var(--color-ink); }
  .add-btn:hover { color: var(--color-accent); }

  .result-line {
    margin: 0.25rem 0 0.65rem;
    font-size: 12.5px;
    color: var(--color-muted);
  }

  .lib-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .lib-row {
    border-bottom: 1px solid var(--color-line);
  }
  .lib-row[hidden] { display: none; }
  .lib-link {
    display: block;
    padding: 0.85rem 0.25rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  .lib-link:hover { background: color-mix(in oklab, var(--color-ink) 4%, transparent); }
  .lib-link:hover .lib-title { color: var(--color-accent); }
  .lib-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .lib-title {
    font-weight: 600;
    font-size: 15px;
    line-height: 1.4;
  }
  .lib-date {
    font-size: 12px;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .lib-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.3rem;
    font-size: 11.5px;
    color: var(--color-muted);
  }
  .tag {
    display: inline-block;
    padding: 0.05rem 0.45rem;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--color-ink) 7%, transparent);
  }
  .lib-summary {
    margin: 0.35rem 0 0;
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .empty {
    font-size: 14px;
    color: var(--color-muted);
    margin-top: 1.5rem;
  }
</style>

<script define:vars={{ combined, exportName }}>
  // 태그 필터 (OR / 합집합)
  const chips = [...document.querySelectorAll('.tag-chip')];
  const allChip = document.querySelector('.tag-chip[data-tag="*"]');
  const rows = [...document.querySelectorAll('.lib-row')];
  const countEl = document.querySelector('[data-result-count]');
  const emptyEl = document.querySelector('[data-empty-msg]');
  const active = new Set();

  function apply() {
    if (allChip) allChip.classList.toggle('is-active', active.size === 0);
    for (const c of chips) {
      if (c === allChip) continue;
      c.classList.toggle('is-active', active.has(c.dataset.tag));
    }
    let shown = 0;
    for (const row of rows) {
      const tags = (row.dataset.tags || '').split('|').filter(Boolean);
      const ok = active.size === 0 || tags.some((t) => active.has(t));
      row.hidden = !ok;
      if (ok) shown++;
    }
    if (countEl) countEl.textContent = String(shown);
    if (emptyEl) emptyEl.hidden = shown !== 0;
  }

  for (const c of chips) {
    c.addEventListener('click', () => {
      const tag = c.dataset.tag;
      if (tag === '*') active.clear();
      else if (active.has(tag)) active.delete(tag);
      else active.add(tag);
      apply();
    });
  }

  // ?tag=... deep-link from entry pages
  const wanted = new URLSearchParams(location.search).get('tag');
  if (wanted && chips.some((c) => c.dataset.tag === wanted)) {
    active.add(wanted);
    apply();
  }

  // 전체 .md 다운로드
  const exportBtn = document.getElementById('export-all');
  if (exportBtn) {
    exportBtn.addEventListener('click', () => {
      const blob = new Blob([combined], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = exportName;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });
  }
</script>
