---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import { firstHeadingAsTitle, firstParagraphAsSummary, prettyIdToTitle } from '../../lib/meta';

const entries = (await getCollection('checklists')).slice().sort((a, b) => {
  const order = ['onboarding', 'security_checklist', 'new_project_checklist', 'ai_code_review', 'multi_env_guide'];
  const ia = order.indexOf(a.id.toLowerCase());
  const ib = order.indexOf(b.id.toLowerCase());
  if (ia === -1 && ib === -1) return a.id.localeCompare(b.id);
  if (ia === -1) return 1;
  if (ib === -1) return -1;
  return ia - ib;
});
---

<Base title="체크리스트 · meticulous-monet" pageTitle="체크리스트">
  <header class="pb-8">
    <p class="text-[12px] uppercase tracking-[0.18em] text-[var(--color-muted)]">Checklists</p>
    <h1 class="mt-2 text-[26px] sm:text-[30px] leading-tight tracking-tight font-semibold">
      체크리스트
    </h1>
    <p class="mt-3 text-[15px] text-[var(--color-muted)] leading-relaxed max-w-[62ch]">
      매 세션 시작 전 · 신규 프로젝트 착수 전 · AI 생성 코드 배포 전 등
      상황별로 훑어야 하는 체크리스트입니다.
    </p>
  </header>

  <div class="grid gap-3">
    {
      entries.map((entry) => (
        <EntryCard
          href={`/checklists/${entry.id}/`}
          title={firstHeadingAsTitle(entry.body, prettyIdToTitle(entry.id))}
          description={firstParagraphAsSummary(entry.body)}
          tag="CHECKLIST"
        />
      ))
    }
  </div>
</Base>
