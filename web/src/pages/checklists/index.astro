---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { firstHeadingAsTitle, firstParagraphAsSummary, prettyIdToTitle } from '../../lib/meta';

const order = ['onboarding', 'security_checklist', 'new_project_checklist', 'repo_hardening', 'ai_code_review', 'multi_env_guide'];
const entries = (await getCollection('checklists')).slice().sort((a, b) => {
  const ia = order.indexOf(a.id.toLowerCase());
  const ib = order.indexOf(b.id.toLowerCase());
  if (ia === -1 && ib === -1) return a.id.localeCompare(b.id);
  if (ia === -1) return 1;
  if (ib === -1) return -1;
  return ia - ib;
});
---

<Base title="체크리스트 · meticulous-monet" pageTitle="체크리스트">
  <article class="prose">
    <h1>체크리스트</h1>
    <p>
      매 세션 시작 전 · 신규 프로젝트 착수 전 · AI 생성 코드 배포 전 등
      상황별로 훑어야 하는 체크리스트입니다. 권장 순서대로 정렬되어 있어요.
    </p>

    <ul class="doc-list">
      {entries.map((entry) => (
        <li>
          <a href={`/checklists/${entry.id}/`} class="doc-link">
            <span class="doc-title">{firstHeadingAsTitle(entry.body, prettyIdToTitle(entry.id))}</span>
            {firstParagraphAsSummary(entry.body) && (
              <span class="doc-summary">{firstParagraphAsSummary(entry.body)}</span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </article>
</Base>

<style>
  .doc-list {
    list-style: none;
    padding: 0;
    margin: 1.4em 0;
  }
  .doc-list li {
    margin: 0;
    border-bottom: 1px solid var(--color-line);
  }
  .doc-list li:first-child { border-top: 1px solid var(--color-line); }
  .doc-link {
    display: block;
    padding: 0.85rem 0.25rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  .doc-link:hover {
    background: color-mix(in oklab, var(--color-ink) 4%, transparent);
  }
  .doc-link:hover .doc-title { color: var(--color-accent); }
  .doc-title {
    display: block;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.4;
  }
  .doc-summary {
    display: block;
    margin-top: 0.25rem;
    color: var(--color-muted);
    font-size: 13.5px;
    line-height: 1.55;
  }
</style>
