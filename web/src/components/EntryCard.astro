---
interface Props {
  href: string;
  title: string;
  description?: string;
  meta?: string;
  tag?: string;
}
const { href, title, description, meta, tag } = Astro.props;
---

<a
  href={href}
  class="group block border border-[var(--color-line)] rounded-lg px-4 py-4 sm:px-5 sm:py-5 hover:border-[var(--color-ink)] transition-colors"
>
  {
    (tag || meta) && (
      <div class="flex items-center gap-2 text-[12px] text-[var(--color-muted)] mb-1.5">
        {tag && (
          <span class="uppercase tracking-wider">{tag}</span>
        )}
        {tag && meta && <span aria-hidden="true">·</span>}
        {meta && <span>{meta}</span>}
      </div>
    )
  }
  <h3 class="text-[15px] sm:text-base font-semibold leading-snug tracking-tight group-hover:text-[var(--color-accent)] transition-colors">
    {title}
  </h3>
  {
    description && (
      <p class="mt-1.5 text-[13.5px] text-[var(--color-muted)] leading-relaxed line-clamp-3">
        {description}
      </p>
    )
  }
</a>
