---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <nav aria-label="현재 위치" class="crumbs">
      <ol>
        {items.map((c, i) => (
          <li>
            {c.href && i < items.length - 1 ? (
              <a href={c.href}>{c.label}</a>
            ) : (
              <span aria-current={i === items.length - 1 ? 'page' : undefined}>{c.label}</span>
            )}
            {i < items.length - 1 && <span class="sep" aria-hidden="true">/</span>}
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .crumbs {
    font-size: 12px;
    color: var(--color-muted);
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
  }
  .crumbs ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0;
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
  }
  .crumbs a {
    color: var(--color-muted);
    text-decoration: none;
  }
  .crumbs a:hover { color: var(--color-ink); }
  .crumbs .sep {
    margin: 0 0.5rem;
    opacity: 0.5;
  }
  .crumbs [aria-current='page'] { color: var(--color-ink); }
</style>
