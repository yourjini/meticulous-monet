---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p>© {year} meticulous-monet · Claude Code 안전 사용 웹진</p>
    <p class="footer-links">
      <a href="https://github.com/yourjini/meticulous-monet">GitHub</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    margin-top: 2.5rem;
  }
  .footer-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.75rem 1rem;
    font-size: 13px;
    color: var(--color-muted);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-links {
    display: flex;
    gap: 1rem;
  }
  .footer-links a {
    color: var(--color-muted);
    text-decoration: none;
  }
  .footer-links a:hover { color: var(--color-ink); }

  @media (min-width: 640px) {
    .footer-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  @media (min-width: 1024px) {
    .footer-inner { padding: 1.75rem 1.5rem; }
  }
</style>
