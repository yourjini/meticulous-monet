---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: '홈' },
  { href: '/checklists/', label: '체크리스트' },
  { href: '/prompts/', label: '프롬프트' },
  { href: '/about/', label: '소개' },
];

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---

<header class="border-b border-[var(--color-line)]">
  <div class="mx-auto w-full max-w-3xl px-5 sm:px-6 py-4 flex items-center justify-between gap-4">
    <a href="/" class="font-semibold tracking-tight text-[15px] flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-accent)]"></span>
      meticulous-monet
    </a>
    <nav aria-label="주요" class="text-[13px]">
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-1 justify-end">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  'text-[var(--color-muted)] hover:text-[var(--color-ink)] transition-colors',
                  isActive(href) && 'text-[var(--color-ink)] font-medium',
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
