---
import { buildNav, isLeaf, type NavSection, type NavGroup, type NavLeaf } from '../lib/nav';

const nav = await buildNav();
const path = Astro.url.pathname;

function eq(href: string) {
  const a = path.replace(/\/$/, '');
  const b = href.replace(/\/$/, '');
  return a === b;
}
function within(href?: string) {
  if (!href || href === '/') return false;
  return path.startsWith(href);
}
function groupActive(g: NavGroup) {
  return g.items.some((c) => eq(c.href));
}
---

<aside class="sidebar">
  <div class="sidebar-inner">
    <a href="/" class="brand">
      <span class="brand-dot" aria-hidden="true"></span>
      meticulous-monet
    </a>

    <div id="search" class="search-slot"></div>

    <nav aria-label="사이드바" class="sb-nav">
      {
        nav.map((section: NavSection) =>
          section.items && section.items.length > 0 ? (
            <details class="sb-section" open={within(section.href)}>
              <summary class="sb-summary">
                <span class="sb-chev" aria-hidden="true">▸</span>
                <span class="sb-summary-label">{section.label}</span>
              </summary>
              <ul class="sb-children">
                {section.href && (
                  <li>
                    <a
                      href={section.href}
                      class:list={['sb-link sb-overview', eq(section.href) && 'is-current']}
                    >
                      전체
                    </a>
                  </li>
                )}
                {section.items.map((item: NavLeaf | NavGroup) =>
                  isLeaf(item) ? (
                    <li>
                      <a
                        href={item.href}
                        class:list={['sb-link sb-leaf', eq(item.href) && 'is-current']}
                      >
                        {item.label}
                      </a>
                    </li>
                  ) : (
                    <li class="sb-group-li">
                      <details class="sb-group" open={groupActive(item)}>
                        <summary class="sb-summary sb-summary-sub">
                          <span class="sb-chev sb-chev-sm" aria-hidden="true">▸</span>
                          <span class="sb-group-label">{item.label}</span>
                        </summary>
                        <ul class="sb-grandchildren">
                          {item.items.map((leaf) => (
                            <li>
                              <a
                                href={leaf.href}
                                class:list={['sb-link sb-leaf', eq(leaf.href) && 'is-current']}
                              >
                                {leaf.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    </li>
                  ),
                )}
              </ul>
            </details>
          ) : (
            section.href && (
              <a
                href={section.href}
                class:list={['sb-link sb-toplink', eq(section.href) && 'is-current']}
              >
                {section.label}
              </a>
            )
          ),
        )
      }
    </nav>
  </div>
</aside>

<div class="nav-backdrop" data-nav-close></div>

<style>
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: 18rem;
    max-width: 85vw;
    z-index: 40;
    background: var(--color-paper);
    border-right: 1px solid var(--color-line);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(-100%);
    transition: transform 0.2s ease;
  }
  :global(body.nav-open) .sidebar { transform: translateX(0); }

  .nav-backdrop {
    position: fixed;
    inset: 0;
    background: color-mix(in oklab, #000 38%, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 30;
  }
  :global(body.nav-open) .nav-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .sidebar-inner {
    padding: 1.25rem 1.25rem 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-size: 15px;
    text-decoration: none;
  }
  .brand-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-accent);
  }

  .search-slot {
    margin-top: 1.25rem;
    min-height: 2.25rem;
  }

  .sb-nav {
    margin-top: 1rem;
    font-size: 13.5px;
    line-height: 1.55;
  }

  /* details / summary 토글 — 기본 마커 숨기고 우리 chevron 사용 */
  .sb-section,
  .sb-group { margin: 0.05rem 0; }
  .sb-summary {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    user-select: none;
    padding: 0.25rem 0.45rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 13.5px;
    list-style: none;
  }
  .sb-summary::-webkit-details-marker { display: none; }
  .sb-summary:hover {
    background: color-mix(in oklab, var(--color-ink) 5%, transparent);
  }

  .sb-chev {
    display: inline-block;
    width: 0.85em;
    text-align: center;
    color: var(--color-muted);
    transition: transform 0.15s ease;
    font-size: 0.78em;
    line-height: 1;
    flex-shrink: 0;
  }
  details[open] > .sb-summary > .sb-chev { transform: rotate(90deg); }

  .sb-summary-sub {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 500;
    color: var(--color-muted);
    margin-top: 0.35rem;
    padding: 0.2rem 0.45rem;
  }
  .sb-summary-sub:hover { color: var(--color-ink); background: transparent; }

  .sb-link {
    display: block;
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    color: var(--color-ink);
    text-decoration: none;
    border-left: 2px solid transparent;
  }
  .sb-link:hover { background: color-mix(in oklab, var(--color-ink) 5%, transparent); }
  .sb-link.is-current {
    color: var(--color-accent);
    font-weight: 600;
    border-left-color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 7%, transparent);
  }

  .sb-toplink {
    font-weight: 600;
    margin-top: 0.05rem;
  }

  .sb-children {
    margin: 0.15rem 0 0.4rem;
    padding-left: 0.7rem;
    border-left: 1px solid var(--color-line);
    list-style: none;
  }
  .sb-overview {
    color: var(--color-muted);
    font-size: 11.5px;
    font-style: italic;
  }
  .sb-overview.is-current { font-style: normal; }

  .sb-leaf {
    color: var(--color-muted);
    font-size: 12.5px;
  }
  .sb-leaf.is-current { color: var(--color-accent); }

  .sb-group-li { margin-top: 0.1rem; }
  .sb-group-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .sb-grandchildren {
    padding-left: 0.65rem;
    border-left: 1px solid var(--color-line);
    list-style: none;
    margin: 0.1rem 0 0.3rem;
  }

  @media (min-width: 1024px) {
    .sidebar {
      position: sticky;
      top: 0;
      inset: auto;
      width: auto;
      max-width: none;
      max-height: 100svh;
      transform: none;
      border-right: 0;
      background: transparent;
      padding: 0;
    }
    .sidebar-inner {
      padding: 2.25rem 1rem 2rem 0;
    }
    .nav-backdrop { display: none; }
  }

  /* Pagefind UI 톤 맞춤 */
  :global(.pagefind-ui) {
    --pagefind-ui-scale: 0.78;
    --pagefind-ui-primary: var(--color-ink);
    --pagefind-ui-text: var(--color-ink);
    --pagefind-ui-background: var(--color-paper);
    --pagefind-ui-border: var(--color-line);
    --pagefind-ui-tag: color-mix(in oklab, var(--color-ink) 7%, transparent);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-image-border-radius: 4px;
    --pagefind-ui-image-box-ratio: 1 / 1;
    --pagefind-ui-font: var(--font-sans);
  }
  :global(.pagefind-ui__search-input) {
    font-size: 13.5px !important;
  }
  :global(.pagefind-ui__drawer:not(.pagefind-ui__hidden)) {
    position: absolute;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 0.5rem;
    margin-top: 0.35rem;
    z-index: 50;
    box-shadow: 0 6px 24px -8px color-mix(in oklab, #000 25%, transparent);
    max-width: 32rem;
  }
  :global(.search-slot) { position: relative; }
</style>

<script>
  const close = () => document.body.classList.remove('nav-open');
  document.querySelectorAll('[data-nav-close]').forEach((el) => el.addEventListener('click', close));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
  // 모바일에선 링크 클릭 시 드로워 닫기 (summary 클릭은 토글이므로 닫지 않음).
  const mq = window.matchMedia('(max-width: 1023px)');
  document.querySelectorAll('.sidebar a').forEach((a) => {
    a.addEventListener('click', () => { if (mq.matches) close(); });
  });
</script>
