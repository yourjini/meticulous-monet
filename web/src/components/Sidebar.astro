---
import { buildNav, isLeaf, type NavSection, type NavGroup, type NavLeaf } from '../lib/nav';

const nav = await buildNav();
const path = Astro.url.pathname;

function eq(href: string) {
  // Treat `/foo/` and `/foo` as the same.
  const a = path.replace(/\/$/, '');
  const b = href.replace(/\/$/, '');
  return a === b;
}
function within(href?: string) {
  if (!href || href === '/') return false;
  return path.startsWith(href);
}
function groupActive(g: NavGroup) {
  return g.items.some((c) => eq(c.href));
}
---

<aside class="sidebar">
  <div class="sidebar-inner">
    <a href="/" class="brand">
      <span class="brand-dot" aria-hidden="true"></span>
      meticulous-monet
    </a>

    <div id="search" class="search-slot"></div>

    <nav aria-label="사이드바" class="sb-nav">
      {
        nav.map((section: NavSection) => (
          <div class="sb-section">
            {section.href ? (
              <a
                href={section.href}
                class:list={[
                  'sb-link sb-section-link',
                  eq(section.href) && 'is-current',
                  !eq(section.href) && within(section.href) && 'is-within',
                ]}
              >
                {section.label}
              </a>
            ) : (
              <div class="sb-section-label">{section.label}</div>
            )}

            {section.items && section.items.length > 0 && (
              <ul class:list={['sb-children', !within(section.href) && 'is-collapsed']}>
                {section.items.map((item: NavLeaf | NavGroup) =>
                  isLeaf(item) ? (
                    <li>
                      <a href={item.href} class:list={['sb-link sb-leaf', eq(item.href) && 'is-current']}>
                        {item.label}
                      </a>
                    </li>
                  ) : (
                    <li class="sb-group">
                      <div class:list={['sb-group-label', groupActive(item) && 'is-within']}>{item.label}</div>
                      <ul class="sb-grandchildren">
                        {item.items.map((leaf) => (
                          <li>
                            <a href={leaf.href} class:list={['sb-link sb-leaf', eq(leaf.href) && 'is-current']}>
                              {leaf.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ),
                )}
              </ul>
            )}
          </div>
        ))
      }
    </nav>
  </div>
</aside>

<div class="nav-backdrop" data-nav-close></div>

<style>
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: 18rem;
    max-width: 85vw;
    z-index: 40;
    background: var(--color-paper);
    border-right: 1px solid var(--color-line);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(-100%);
    transition: transform 0.2s ease;
  }
  :global(body.nav-open) .sidebar { transform: translateX(0); }

  .nav-backdrop {
    position: fixed;
    inset: 0;
    background: color-mix(in oklab, #000 38%, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 30;
  }
  :global(body.nav-open) .nav-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .sidebar-inner {
    padding: 1.25rem 1.25rem 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-size: 15px;
    text-decoration: none;
  }
  .brand-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-accent);
  }

  .search-slot {
    margin-top: 1.25rem;
    min-height: 2.25rem;
  }

  .sb-nav {
    margin-top: 1rem;
    font-size: 13.5px;
    line-height: 1.55;
  }

  .sb-section + .sb-section { margin-top: 0.5rem; }

  .sb-link {
    display: block;
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    color: var(--color-ink);
    text-decoration: none;
    border-left: 2px solid transparent;
  }
  .sb-link:hover { background: color-mix(in oklab, var(--color-ink) 5%, transparent); }
  .sb-link.is-current {
    color: var(--color-accent);
    font-weight: 600;
    border-left-color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 7%, transparent);
  }
  .sb-link.is-within {
    color: var(--color-ink);
    font-weight: 600;
  }

  .sb-section-link {
    font-weight: 600;
    padding-left: 0.25rem;
    margin-left: -0.25rem;
  }
  .sb-section-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-muted);
    margin-top: 1rem;
    padding: 0.25rem 0.25rem 0.4rem;
  }

  .sb-children {
    margin: 0.1rem 0 0;
    padding-left: 0.65rem;
    border-left: 1px solid var(--color-line);
    list-style: none;
  }
  .sb-children.is-collapsed { display: none; }

  .sb-leaf {
    color: var(--color-muted);
    font-size: 12.5px;
  }
  .sb-leaf.is-current { color: var(--color-accent); }

  .sb-group { margin-top: 0.4rem; }
  .sb-group-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-muted);
    padding: 0.2rem 0.45rem;
  }
  .sb-group-label.is-within { color: var(--color-ink); }
  .sb-grandchildren {
    padding-left: 0.55rem;
    border-left: 1px solid var(--color-line);
    list-style: none;
    margin: 0.05rem 0 0;
  }

  @media (min-width: 1024px) {
    .sidebar {
      position: sticky;
      top: 0;
      inset: auto;
      width: auto;
      max-width: none;
      max-height: 100svh;
      transform: none;
      border-right: 0;
      background: transparent;
      padding: 0;
    }
    .sidebar-inner {
      padding: 2.25rem 1rem 2rem 0;
    }
    .nav-backdrop { display: none; }
  }

  /* Pagefind UI 톤 맞춤 */
  :global(.pagefind-ui) {
    --pagefind-ui-scale: 0.78;
    --pagefind-ui-primary: var(--color-ink);
    --pagefind-ui-text: var(--color-ink);
    --pagefind-ui-background: var(--color-paper);
    --pagefind-ui-border: var(--color-line);
    --pagefind-ui-tag: color-mix(in oklab, var(--color-ink) 7%, transparent);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-image-border-radius: 4px;
    --pagefind-ui-image-box-ratio: 1 / 1;
    --pagefind-ui-font: var(--font-sans);
  }
  :global(.pagefind-ui__search-input) {
    font-size: 13.5px !important;
  }
  :global(.pagefind-ui__drawer:not(.pagefind-ui__hidden)) {
    position: absolute;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 0.5rem;
    margin-top: 0.35rem;
    z-index: 50;
    box-shadow: 0 6px 24px -8px color-mix(in oklab, #000 25%, transparent);
    max-width: 32rem;
  }
  :global(.search-slot) { position: relative; }
</style>

<script>
  // 모바일 햄버거: backdrop / Esc / 링크 클릭 시 닫기.
  const close = () => document.body.classList.remove('nav-open');
  document.querySelectorAll('[data-nav-close]').forEach((el) => el.addEventListener('click', close));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
  // 사이드바 내부 링크 클릭 시 (해시 변경 등 제외하고) 닫기 — 모바일에서만 의미 있음.
  const mq = window.matchMedia('(max-width: 1023px)');
  document.querySelectorAll('.sidebar a').forEach((a) => {
    a.addEventListener('click', () => { if (mq.matches) close(); });
  });
</script>
